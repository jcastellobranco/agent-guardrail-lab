{
  "name": "@lab/guardrail-api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests scripts",
    "dev": "node --env-file-if-exists=.env --watch dist/server.js",
    "keys": "node scripts/keys.mjs",
    "demo": "node scripts/demo.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "demo:probes": "node scripts/demo-probes.mjs"
  },
  "dependencies": {
    "@lab/contracts": "workspace:*",
    "@lab/policy-engine": "workspace:*",
    "fastify": "^5.3.0",
    "jose": "^6.0.0",
    "prom-client": "15.1.3",
    "zod": "3.25.76",
    "@lab/bundles": "workspace:*",
    "@lab/local-audit": "workspace:*"
  },
  "files": [
    "dist",
    "scripts"
  ]
}
